# Core
DATABASE_URL=sqlite:///./freelance_hunter.db
LOG_LEVEL=INFO
MIN_NOTIFICATION_SCORE=70
MIN_BUDGET_RUB=3000
HUNTER_MODE=manual
POLL_INTERVAL_MINUTES=10
TELEGRAM_SCORE_THRESHOLD=50

# Comma-separated official RSS URLs selected in FL.ru's "Subscribe via RSS" UI.
FL_RSS_URLS=https://www.fl.ru/rss/?category=41,https://www.fl.ru/rss/?subcategory=798&category=5,https://www.fl.ru/rss/?subcategory=279&category=5,https://www.fl.ru/rss/?subcategory=585&category=5,https://www.fl.ru/rss/?subcategory=703&category=5,https://www.fl.ru/rss/?subcategory=280&category=5,https://www.fl.ru/rss/?category=31

# AI: mock is safe for local development and tests. A non-mock provider needs AI_API_KEY.
AI_PROVIDER=mock
AI_API_KEY=

# Controlled real-AI evaluation only. Keep AI_PROVIDER=mock for normal runs.
POLZA_API_KEY=
POLZA_MODEL=qwen/qwen3.8-flash
POLZA_BASE_URL=https://polza.ai/api/v1

# Telegram notification and feedback. Leave both blank to run without Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
